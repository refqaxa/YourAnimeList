@model YourAnimeList.ViewModels.AnimeIndexViewModel

@{
    ViewData["Title"] = "Anime List";
}

<h1>Anime Shows</h1>

<p>
    @if (User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    }
    else
    {
        <p>Log in om een Anime title toe te voegen</p>
    }
</p>

<!-- Search Form -->
@* <form method="get" asp-action="Index" class="mb-3"> *@
@*     <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Search Anime" /> *@
@*     <button type="submit" class="btn btn-primary">Search</button> *@
@* </form> *@

@if (!Model.Animes.Any())
{
    <div class="alert alert-warning" role="alert">
        No Animes were found :(
        <a href="@Url.Action("Index", "Animes")" class="btn btn-secondary btn-sm">Back to all Animes</a>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a href="@Url.Action("Index", "Animes", new { sortOrder = "Name" })">
                        @Html.DisplayNameFor(model => model.Animes.FirstOrDefault().Name)
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Index", "Animes", new { sortOrder = "Episodes" })">
                        @Html.DisplayNameFor(model => model.Animes.FirstOrDefault().Episodes)
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Index", "Animes", new { sortOrder = "Aired" })">
                        @Html.DisplayNameFor(model => model.Animes.FirstOrDefault().Aired)
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Index", "Animes", new { sortOrder = "AddedBy" })">
                        Added By
                    </a>
                </th>
            <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Animes)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Episodes</td>
                    <td>@item.Aired.ToShortDateString()</td>
                    <td>@item.AddedBy</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>

                        @if (User.Identity.IsAuthenticated && (User.Identity.Name.Split('@')[0] == item.AddedBy.ToLower() || User.IsInRole("Admin")))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="@Url.Action("Index", "Animes", new { page = i, searchQuery = Model.SearchQuery })" class="btn btn-link @((i == Model.CurrentPage) ? "active" : "")">
                @i
            </a>
        }
    </div>
}
